---
interface Props {
  title: string;
  headline: string;
  subtitle: string;
  pdfUrl: string;
  valueProps: string[];
  ctaText: string;
  previewDescription: string;
  pages: number;
  type: string;
  slug: string;
}

const { title, headline, subtitle, pdfUrl, valueProps, ctaText, previewDescription, pages, type, slug } = Astro.props;

const typeLabels: Record<string, string> = {
  'guide': 'Guide',
  'cheatsheet': 'Cheatsheet',
  'checklist': 'Checklist',
  'quick-reference': 'Quick Reference',
  'how-to-guide': 'How-To Guide',
};
const typeLabel = typeLabels[type] || 'Guide';
const badge = `Free ${pages}-Page ${typeLabel}`;
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={subtitle} />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
</head>
<body class="bg-light text-dark font-sans antialiased">

  <!-- Hero -->
  <section class="relative bg-dark overflow-hidden">
    <!-- Subtle pattern overlay -->
    <div class="absolute inset-0 opacity-[0.04]" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 32px 32px;"></div>

    <div class="relative max-w-4xl mx-auto px-6 pt-20 pb-24 text-center">
      <!-- Badge -->
      <span class="inline-flex items-center gap-2 bg-accent/15 text-accent text-sm font-bold px-5 py-2 rounded-full mb-8 border border-accent/20 backdrop-blur-sm">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z"/><path fill-rule="evenodd" d="M4 5a2 2 0 012-2 3 3 0 003 3h2a3 3 0 003-3 2 2 0 012 2v11a2 2 0 01-2 2H6a2 2 0 01-2-2V5zm3 4a1 1 0 000 2h.01a1 1 0 100-2H7zm3 0a1 1 0 000 2h3a1 1 0 100-2h-3zm-3 4a1 1 0 100 2h.01a1 1 0 100-2H7zm3 0a1 1 0 100 2h3a1 1 0 100-2h-3z" clip-rule="evenodd"/></svg>
        {badge}
      </span>

      <h1 class="text-4xl md:text-5xl lg:text-[3.5rem] font-extrabold leading-[1.1] mb-6 text-light tracking-tight">
        {headline}
      </h1>
      <p class="text-lg md:text-xl text-light/70 max-w-2xl mx-auto leading-relaxed">
        {subtitle}
      </p>
    </div>

    <!-- Curved bottom edge -->
    <div class="absolute bottom-0 left-0 right-0">
      <svg viewBox="0 0 1440 60" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full">
        <path d="M0 60L1440 60L1440 0C1440 0 1080 60 720 60C360 60 0 0 0 0L0 60Z" fill="#E9E4CF"/>
      </svg>
    </div>
  </section>

  <!-- Two-column: Value Props + Form -->
  <section class="max-w-5xl mx-auto px-6 -mt-6 pb-16">
    <div class="grid md:grid-cols-2 gap-8 items-start">

      <!-- Left: Value Props -->
      <div class="pt-8">
        <h2 class="text-sm font-bold text-accent uppercase tracking-widest mb-6">What you'll get</h2>
        <div class="space-y-5">
          {valueProps.map((prop, i) => (
            <div class="flex items-start gap-4 group">
              <div class="flex-shrink-0 w-10 h-10 bg-dark rounded-xl flex items-center justify-center shadow-md group-hover:scale-105 transition-transform">
                <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <p class="text-dark/80 text-[15px] leading-relaxed pt-2">{prop}</p>
            </div>
          ))}
        </div>

        <!-- Social proof / trust -->
        <div class="mt-8 flex items-center gap-3 text-dark/50 text-sm">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/></svg>
          No spam. Your info stays private.
        </div>
      </div>

      <!-- Right: Form Card -->
      <div id="form-section" class="bg-white rounded-2xl shadow-xl border border-dark/5 p-8 md:p-10 relative">
        <!-- Accent top bar -->
        <div class="absolute top-0 left-8 right-8 h-1 bg-accent rounded-b-full"></div>

        <h2 class="text-2xl font-bold text-center mb-2 pt-2">Get Instant Access</h2>
        <p class="text-dark/50 text-center text-sm mb-8">{previewDescription}</p>

        <!-- Lead Form -->
        <form id="lead-form" class="space-y-5">
          <div>
            <label for="name" class="block text-sm font-semibold text-dark/70 mb-1.5">First Name</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              placeholder="Your first name"
              class="w-full px-4 py-3.5 bg-light/50 border border-dark/10 rounded-xl focus:ring-2 focus:ring-accent/30 focus:border-accent outline-none transition text-dark placeholder:text-dark/30"
            />
          </div>
          <div>
            <label for="email" class="block text-sm font-semibold text-dark/70 mb-1.5">Email</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="you@example.com"
              class="w-full px-4 py-3.5 bg-light/50 border border-dark/10 rounded-xl focus:ring-2 focus:ring-accent/30 focus:border-accent outline-none transition text-dark placeholder:text-dark/30"
            />
          </div>
          <button
            type="submit"
            class="w-full bg-accent hover:bg-accent-dark text-white font-bold py-4 px-6 rounded-xl transition-all text-lg cursor-pointer shadow-lg shadow-accent/25 hover:shadow-xl hover:shadow-accent/30 hover:-translate-y-0.5 active:translate-y-0"
          >
            {ctaText}
          </button>
        </form>

        <!-- Success / Resource Reveal (hidden by default) -->
        <div id="resource-reveal" class="hidden text-center py-6">
          <div class="inline-flex items-center justify-center w-16 h-16 bg-dark/10 rounded-2xl mb-4">
            <svg class="w-8 h-8 text-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
          </div>
          <h3 class="text-2xl font-bold mb-2">Here's your {typeLabel.toLowerCase()}!</h3>
          <p class="text-dark/50 mb-6">Click below to view or download.</p>
          <a
            href={pdfUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-accent hover:bg-accent-dark text-white font-bold py-4 px-8 rounded-xl transition-all text-lg shadow-lg shadow-accent/25 hover:shadow-xl hover:-translate-y-0.5"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
            View & Download {typeLabel}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Sales Copy (from markdown body) -->
  <section class="bg-white border-y border-dark/5">
    <div class="max-w-5xl mx-auto px-6 py-20">
      <div class="sales-copy">
        <slot />
      </div>
    </div>
  </section>

  <style is:global>
    /* ── Sales Copy Card System ── */
    .sales-copy {
      /* JS will wrap each h2 + siblings into .sc-card divs */
    }
    .sc-cards-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }
    @media (max-width: 768px) {
      .sc-cards-grid { grid-template-columns: 1fr; }
    }
    .sc-card {
      background: #FAFAF6;
      border: 1px solid rgba(15, 61, 25, 0.06);
      border-radius: 1rem;
      padding: 2rem;
      transition: box-shadow 0.2s, transform 0.2s;
    }
    .sc-card:hover {
      box-shadow: 0 8px 30px rgba(15, 61, 25, 0.06);
      transform: translateY(-2px);
    }
    /* Icon circle at top of each card */
    .sc-card-icon {
      width: 2.75rem;
      height: 2.75rem;
      background: #0F3D19;
      border-radius: 0.75rem;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 1.25rem;
    }
    .sc-card-icon svg {
      width: 1.25rem;
      height: 1.25rem;
      color: #F94600;
    }
    .sales-copy h2 {
      font-size: 0.7rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      color: #F94600;
      margin: 0 0 1rem 0;
      padding-bottom: 0.75rem;
      border-bottom: 2px solid #E9E4CF;
    }
    .sales-copy p {
      font-size: 0.95rem;
      line-height: 1.8;
      color: rgba(15, 61, 25, 0.6);
      margin: 0 0 0.75rem 0;
    }
    .sales-copy p:last-child {
      margin-bottom: 0;
    }
    .sales-copy p strong {
      color: #0F3D19;
      font-weight: 700;
    }
  </style>

  <!-- Group markdown h2 sections into cards -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const container = document.querySelector('.sales-copy');
      if (!container) return;

      const icons = [
        // Clipboard/document icon
        '<svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>',
        // Users/people icon
        '<svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>',
        // Lightbulb icon
        '<svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>',
        // Rocket icon
        '<svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.59 14.37a6 6 0 01-5.84 7.38v-4.8m5.84-2.58a14.98 14.98 0 006.16-12.12A14.98 14.98 0 009.63 8.41m5.96 5.96a14.926 14.926 0 01-5.841 2.58m-.119-8.54a6 6 0 00-7.381 5.84h4.8m2.581-5.84a14.927 14.927 0 00-2.58 5.84m2.699 2.7c-.103.021-.207.041-.311.06a15.09 15.09 0 01-2.448-2.448 14.9 14.9 0 01.06-.312m-2.24 2.39a4.493 4.493 0 00-1.757 4.306 4.493 4.493 0 004.306-1.758M16.5 9a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z"/></svg>',
      ];

      // Collect all children
      const children = Array.from(container.children);
      const sections = [];
      let current = null;

      children.forEach(el => {
        if (el.tagName === 'H2') {
          if (current) sections.push(current);
          current = { heading: el, content: [] };
        } else if (current) {
          current.content.push(el);
        }
      });
      if (current) sections.push(current);

      // Clear container and build cards
      container.innerHTML = '';
      const grid = document.createElement('div');
      grid.className = 'sc-cards-grid';

      sections.forEach((sec, i) => {
        const card = document.createElement('div');
        card.className = 'sc-card';

        // Add icon
        const iconWrap = document.createElement('div');
        iconWrap.className = 'sc-card-icon';
        iconWrap.innerHTML = icons[i % icons.length];
        card.appendChild(iconWrap);

        // Add heading
        card.appendChild(sec.heading);

        // Add content
        sec.content.forEach(el => card.appendChild(el));

        grid.appendChild(card);
      });

      container.appendChild(grid);
    });
  </script>

  <!-- Footer -->
  <footer class="py-8 text-center text-sm text-dark/30">
    &copy; {new Date().getFullYear()}
  </footer>

  <!-- Form handling script -->
  <script define:vars={{ slug }}>
    const form = document.getElementById('lead-form');
    const reveal = document.getElementById('resource-reveal');

    async function captureLead(name, email) {
      const res = await fetch('/api/capture-lead', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, email, resource: slug }),
      });
      if (!res.ok) throw new Error('Failed');
    }

    function showResource() {
      form.classList.add('hidden');
      reveal.classList.remove('hidden');
    }

    // Check for URL parameters (name/email pre-filled from DM automation)
    const params = new URLSearchParams(window.location.search);
    const mcName = params.get('name') || params.get('first_name') || '';
    const mcEmail = params.get('email') || '';

    if (mcName && mcEmail) {
      captureLead(mcName, mcEmail).catch(() => {});
      showResource();
    } else if (mcEmail) {
      document.getElementById('email').value = mcEmail;
    } else if (mcName) {
      document.getElementById('name').value = mcName;
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector('button[type="submit"]');
      const originalText = btn.textContent;
      btn.textContent = 'Sending...';
      btn.disabled = true;

      const name = form.querySelector('#name').value.trim();
      const email = form.querySelector('#email').value.trim();

      try {
        await captureLead(name, email);
        showResource();
      } catch (err) {
        btn.textContent = originalText;
        btn.disabled = false;
        showResource();
      }
    });
  </script>
</body>
</html>
